# ============================================================================
# DMATHS Learning Hub — Environment Variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (required for live data & auth) ------------------------------
# From your project's Settings → API. The anon key is safe for the browser
# (protected by Row Level Security); the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth providers are configured in the Supabase dashboard
# (Authentication → Providers), not here. See supabase/README.md.
# If you run providers locally via the CLI, set these for supabase/config.toml:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Payments (stubbed until provided — Phase 9) ---------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ---- Video hosting (stubbed until provided — Phase 8) ----------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
BUNNY_STREAM_API_KEY=

# ---- AI features (stubbed until provided) ----------------------------------
# Powers the AI Tutor / Quiz Generator / Course Assistant via Claude.
ANTHROPIC_API_KEY=
