# ============================================================================
# DMATHS Learning Hub — Environment Variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (required for live data & auth) ------------------------------
# From your project's Settings → API. The anon key is safe for the browser
# (protected by Row Level Security); the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth providers are configured in the Supabase dashboard
# (Authentication → Providers), not here. See supabase/README.md.
# If you run providers locally via the CLI, set these for supabase/config.toml:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Payments --------------------------------------------------------------
# Paystack is the live provider (payments in Naira). Get your keys from the
# Paystack dashboard → Settings → API Keys & Webhooks. Only the SECRET key is
# needed for the redirect checkout flow; keep it server-only. Configure the
# webhook URL there as: https://<your-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Other providers (optional / not yet wired for live checkout):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=

# ---- Video hosting (stubbed until provided — Phase 8) ----------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
BUNNY_STREAM_API_KEY=

# ---- AI features -----------------------------------------------------------
# Powers the AI Study Assistant + AI quiz generator via the DeepSeek API.
# Get a key from https://platform.deepseek.com. Without a key, these fall back
# to an offline mock so the UI still works.
DEEPSEEK_API_KEY=
# Optional: override the model (default: deepseek-chat; e.g. deepseek-reasoner).
DEEPSEEK_MODEL=

# ---- Email (Resend) --------------------------------------------------------
# Sends purchase-receipt emails. Get a key at https://resend.com. Without a key
# email is skipped silently. RESEND_FROM must be a verified sender/domain
# (e.g. "D-MATHS <receipts@yourdomain.com>"); defaults to Resend's sandbox.
RESEND_API_KEY=
RESEND_FROM=
